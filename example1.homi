automation "Corda Corredor - movimento" {
   mode "restart"

   when state {
        to "on"

        entity_id [
            binary_sensor.corredor_suite_luminance_motion_sensor_movimento
            binary_sensor.tz3000_6ygjfyll_ts0202
            binary_sensor.motion_sensor_movimento
        ]
    }

    if device { type "is_on" }
    if device { type "is_disarmed" }
    if state { state "off" }

    do turn_on { domain "light" }

    do if {
        condition "time"
        after "01:15:00"
        before "12:00:00"

        then [{
            delay {
                hours 0
                minutes 0
                seconds 45
                milliseconds 0
            }
        }]

        else [{
            delay {
                hours 0
                minutes 1
                seconds 45
                milliseconds 0
            }
        }]
    }
}
